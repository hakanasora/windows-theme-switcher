#include <windows.h>
1 ICON "@CMAKE_SOURCE_DIR@/MyIcon.ico"
1 RT_MANIFEST "@CMAKE_BINARY_DIR@/generated/App.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Hakana Sora\0"
   VALUE "FileDescription", "Windows Theme Switcher\0"
   VALUE "FileVersion", "@TS_VERSION@\0"
   VALUE "ProductName", "Windows Theme Switcher\0"
   VALUE "ProductVersion", "@TS_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
